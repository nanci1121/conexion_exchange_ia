# ==============================================================================
# EMAIL AI - Variables de Entorno
# ==============================================================================
# 
# Copia este archivo a .env y completa los valores
# NO COMMITEES .env a git (contiene credenciales sensibles)
#
# ==============================================================================

# =====================
# EXCHANGE INTEGRATION
# =====================
# Perfil activo legacy/compatibilidad
EXCHANGE_USER=perfil.activo@empresa.com
EXCHANGE_SERVER=mail.empresa.com
EXCHANGE_UPN=usuario@dominio.local
EXCHANGE_PASS=tu_password_seguro
EXCHANGE_FOLDER=INBOX

# Multiples perfiles Exchange
# Usa una sola linea JSON valida.
EXCHANGE_ACTIVE_PROFILE_ID=principal
EXCHANGE_PROFILES_JSON=[{"id":"principal","name":"Perfil principal","email":"perfil.activo@empresa.com","server":"mail.empresa.com","upn":"usuario@dominio.local","password":"tu_password_seguro","folder":"INBOX","is_active":true},{"id":"soporte","name":"Buzon Soporte","email":"soporte@empresa.com","server":"mail.empresa.com","upn":"usuario@dominio.local","password":"otra_password_segura","folder":"Soporte","is_active":false}]

# =====================
# DATABASE
# =====================
# Requeridas por docker compose y la aplicacion
DB_USER=email_ai_user
DB_PASS=cambia_este_password_por_uno_largo_y_unico
DB_HOST=postgres_vectordb
DB_PORT=5432
DB_NAME=knowledge_base

# Publicacion local de puertos
# Usa 127.0.0.1 para no exponer servicios fuera del host.
DB_BIND_HOST=127.0.0.1

# =====================
# LLM SERVICE
# =====================
# Endpoint interno entre contenedores
LLM_API_URL=http://llm_service:8000
LLM_MODEL=Llama-3.2-3B-Instruct
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.1

# Runtime del contenedor LLM
CPU_THREADS=4
LLM_BIND_HOST=127.0.0.1
LLM_PORT=8000

# Opcional: mejora limites/rendimiento al descargar desde Hugging Face
HF_TOKEN=

# =====================
# APPLICATION
# =====================
APP_HOST=0.0.0.0
APP_PORT=8080
APP_BIND_HOST=127.0.0.1
ENVIRONMENT=production

# Opcional: Secret key para sesiones
SECRET_KEY=tu_secret_key_muy_seguro_aqui

# =====================
# LOGGING
# =====================
LOG_LEVEL=INFO
LOG_FILE=/var/log/email_ai/app.log

# =====================
# FEATURES
# =====================
# Enable/disable RAG
ENABLE_RAG=true

# Enable/disable auto-response
ENABLE_AUTO_RESPONSE=false

# Intervalo de polling (segundos)
POLL_INTERVAL=300

# =====================
# NOTIFICATIONS (Optional)
# =====================
# Slack webhook para notificaciones
SLACK_WEBHOOK_URL=

# Email para alertas
ALERT_EMAIL=admin@empresa.com

# =====================
# DEBUG (Solo desarrollo)
# =====================
# DEBUG=false
# TESTING=false
